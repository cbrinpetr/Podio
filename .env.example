# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/act_navigator"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Set to "anthropic" (default) or "openai"
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-6"

# For OpenAI fallback
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# ─── CAPTCHA (Cloudflare Turnstile) ──────────────────────────────────────────
# Leave blank in dev to bypass captcha
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── Admin Bootstrap ─────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@act-navigator.gov.au"
ADMIN_PASSWORD="change-this-before-production"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ACT Innovation Ecosystem Navigator"
NEXT_PUBLIC_MAP_DEFAULT_LAT="-35.2809"
NEXT_PUBLIC_MAP_DEFAULT_LNG="149.1300"
NEXT_PUBLIC_MAP_DEFAULT_ZOOM="12"
